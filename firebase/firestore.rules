rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProduct(data) {
      return data.producerUid == request.auth.uid
        || data.producerId == request.auth.uid
        || data.ownerId == request.auth.uid;
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeProducer(userId) {
      let profile = get(/databases/$(database)/documents/users/$(userId)).data;
      return signedIn()
        && request.auth.uid == userId
        && profile.role == "producer"
        && profile.producerTerms.accepted == true
        && profile.producerTerms.version == "2026-07-25"
        && profile.producerOnboarding.completed == true
        && profile.subscription.status in ["active", "trialing", "paid"];
    }

    function validOptionalDiscount(data) {
      return !data.keys().hasAny(["originalPriceCents"])
        || (
          data.originalPriceCents is int
          && data.originalPriceCents > data.priceCents
          && data.originalPrice is number
          && data.originalPrice * 100 >= data.originalPriceCents - 0.001
          && data.originalPrice * 100 <= data.originalPriceCents + 0.001
          && (!data.keys().hasAny(["discountLabel"])
            || (data.discountLabel is string && data.discountLabel.size() <= 80))
          && (!data.keys().hasAny(["discountEndsAt"])
            || data.discountEndsAt is timestamp)
        );
    }

    function validProduct(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.price is number
        && data.price > 0
        && data.priceCents is int
        && data.priceCents > 0
        && data.price * 100 >= data.priceCents - 0.001
        && data.price * 100 <= data.priceCents + 0.001
        && data.quantityAvailable is int
        && data.quantityAvailable >= 0
        && data.inStock is bool
        && data.producerUid == request.auth.uid
        && data.producerId == request.auth.uid
        && data.ownerId == request.auth.uid
        && validOptionalDiscount(data);
    }

    function acceptedCurrentProducerTerms() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn()
        && profile.role == "producer"
        && profile.producerTerms.accepted == true
        && profile.producerTerms.version == "2026-07-25"
        && profile.producerOnboarding.completed == true
        && profile.subscription.status in ["active", "trialing", "paid"];
    }

    // Products are visible to signed-in members. Producer terms and setup are
    // enforced before a producer may create or change a listing.
    match /products/{productId} {
      allow read: if signedIn();
      allow create: if acceptedCurrentProducerTerms()
        && ownsProduct(request.resource.data)
        && validProduct(request.resource.data);
      allow update: if acceptedCurrentProducerTerms()
        && ownsProduct(resource.data)
        && ownsProduct(request.resource.data)
        && validProduct(request.resource.data)
        && (
          !resource.data.keys().hasAll(["producerUid", "producerId", "ownerId"])
          || (
            request.resource.data.producerUid == resource.data.producerUid
            && request.resource.data.producerId == resource.data.producerId
            && request.resource.data.ownerId == resource.data.ownerId
          )
        );
      // Listings are archived instead of deleted so order references remain intact.
      allow delete: if false;
    }

    // Members may maintain their own profile and accept legal terms, but only
    // trusted Cloud Functions may alter subscription and Stripe account fields.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ["buyer", "producer"]
        && !request.resource.data.keys().hasAny([
          "subscription",
          "subscriptionStatus",
          "stripeCustomerId",
          "stripeConnectAccountId",
          "stripeAccountId"
        ]);
      allow update: if signedIn()
        && request.auth.uid == userId
        && (
          request.resource.data.role == resource.data.role
          || (
            !resource.data.keys().hasAny(["role"])
            && request.resource.data.role in ["buyer", "producer"]
          )
        )
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "subscription",
          "subscriptionStatus",
          "stripeCustomerId",
          "stripeConnectAccountId",
          "stripeAccountId"
        ]);

      match /blocked/{blockedUserId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.blockedUserId == blockedUserId
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 120;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    // Signed-in members may submit safety reports. Reports are intentionally
    // write-only to clients and are reviewed through trusted administrative tools.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.type == "listing"
        && request.resource.data.listingId is string
        && request.resource.data.listingId.size() > 0
        && request.resource.data.reportedUserId is string
        && exists(/databases/$(database)/documents/products/$(request.resource.data.listingId))
        && (
          get(/databases/$(database)/documents/products/$(request.resource.data.listingId)).data.producerId
            == request.resource.data.reportedUserId
          || get(/databases/$(database)/documents/products/$(request.resource.data.listingId)).data.producerUid
            == request.resource.data.reportedUserId
        )
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.status == "open";
      allow read, update, delete: if false;
    }

    // Farm profiles are marketplace information. Only the owning producer writes.
    match /farms/{farmId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == farmId
        && currentProfile().role == "producer"
        && request.resource.data.producerUid == request.auth.uid
        && request.resource.data.farmName is string
        && request.resource.data.farmName.size() > 0
        && request.resource.data.farmName.size() <= 120
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.city.size() <= 120
        && request.resource.data.state == "ME"
        && request.resource.data.zip is string
        && request.resource.data.zip.size() >= 5
        && request.resource.data.zip.size() <= 10
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 30
        && request.resource.data.pickupAvailable is bool
        && request.resource.data.deliveryAvailable is bool
        && (!request.resource.data.keys().hasAny(["description"])
          || (request.resource.data.description is string
            && request.resource.data.description.size() <= 2000))
        && (!request.resource.data.keys().hasAny(["photos"])
          || (request.resource.data.photos is list
            && request.resource.data.photos.size() <= 6))
        && (!request.resource.data.keys().hasAny(["archivedPhotos"])
          || (request.resource.data.archivedPhotos is list
            && request.resource.data.archivedPhotos.size() <= 24))
        && (!request.resource.data.keys().hasAny(["promoPageEnabled"])
          || request.resource.data.promoPageEnabled is bool)
        && (!request.resource.data.keys().hasAny(["promoHeadline"])
          || (request.resource.data.promoHeadline is string
            && request.resource.data.promoHeadline.size() <= 160))
        && (!request.resource.data.keys().hasAny(["promoDescription"])
          || (request.resource.data.promoDescription is string
            && request.resource.data.promoDescription.size() <= 1000))
        && !request.resource.data.keys().hasAny(["addressLine1"]);
      // Some tester profiles predate the complete farm-profile schema. Let an
      // owning producer opt that legacy record into promotions without forcing
      // an unrelated profile migration in the same write.
      allow update: if signedIn()
        && request.auth.uid == farmId
        && currentProfile().role == "producer"
        && (!resource.data.keys().hasAny(["producerUid"])
          || resource.data.producerUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "promoPageEnabled",
          "promoHeadline",
          "promoDescription",
          "updatedAt"
        ])
        && (!request.resource.data.keys().hasAny(["promoPageEnabled"])
          || request.resource.data.promoPageEnabled is bool)
        && (!request.resource.data.keys().hasAny(["promoHeadline"])
          || (request.resource.data.promoHeadline is string
            && request.resource.data.promoHeadline.size() <= 160))
        && (!request.resource.data.keys().hasAny(["promoDescription"])
          || (request.resource.data.promoDescription is string
            && request.resource.data.promoDescription.size() <= 1000));
      allow delete: if false;
    }

    // Producers publish events; each producer controls only their own attendance
    // record so an organizer cannot falsely claim another farm is attending.
    match /events/{eventId} {
      function validEvent(data) {
        return data.hostProducerId == request.auth.uid
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 160
          && data.description is string
          && data.description.size() <= 3000
          && data.venueName is string
          && data.venueName.size() > 0
          && data.venueName.size() <= 160
          && data.address is string
          && data.address.size() <= 240
          && data.city is string
          && data.city.size() > 0
          && data.city.size() <= 120
          && data.state == "ME"
          && data.zip is string
          && data.zip.size() >= 5
          && data.zip.size() <= 10
          && data.categories is list
          && data.categories.size() <= 12
          && data.startAt is timestamp
          && data.endAt is timestamp
          && data.endAt > data.startAt
          && data.status in ["draft", "published", "cancelled"]
          && (!data.keys().hasAny(["lat"])
            || data.lat == null
            || (data.lat is number && data.lat >= -90 && data.lat <= 90))
          && (!data.keys().hasAny(["lng"])
            || data.lng == null
            || (data.lng is number && data.lng >= -180 && data.lng <= 180));
      }

      allow read: if signedIn()
        && (resource.data.status == "published" || resource.data.hostProducerId == request.auth.uid);
      allow create: if activeProducer(request.auth.uid) && validEvent(request.resource.data);
      allow update: if activeProducer(request.auth.uid)
        && resource.data.hostProducerId == request.auth.uid
        && request.resource.data.hostProducerId == resource.data.hostProducerId
        && validEvent(request.resource.data);
      allow delete: if false;

      match /attendees/{producerId} {
        allow read: if signedIn();
        allow create, update: if activeProducer(producerId)
          && request.auth.uid == producerId
          && request.resource.data.producerId == producerId
          && request.resource.data.farmName is string
          && request.resource.data.farmName.size() > 0
          && request.resource.data.farmName.size() <= 120
          && get(/databases/$(database)/documents/events/$(eventId)).data.status == "published";
        allow delete: if signedIn() && request.auth.uid == producerId;
      }
    }

    // Firestore collection-group event attendance queries require a recursive
    // wildcard match. `attendees` is reserved exclusively for public event
    // attendance; writes remain protected by the event-specific rule above.
    match /{eventPath=**}/attendees/{producerId} {
      allow read: if signedIn();
    }

    // Custom producer deals displayed on the shared Promotions page.
    match /promotions/{promotionId} {
      function validPromotion(data) {
        return data.producerId == request.auth.uid
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 160
          && data.description is string
          && data.description.size() > 0
          && data.description.size() <= 2000
          && data.kind in ["deal", "announcement"]
          && data.startsAt is timestamp
          && data.endsAt is timestamp
          && data.endsAt > data.startsAt
          && data.active is bool;
      }

      allow read: if signedIn()
        && (resource.data.active == true || resource.data.producerId == request.auth.uid);
      allow create: if activeProducer(request.auth.uid)
        && validPromotion(request.resource.data);
      allow update: if activeProducer(request.auth.uid)
        && resource.data.producerId == request.auth.uid
        && request.resource.data.producerId == resource.data.producerId
        && validPromotion(request.resource.data);
      allow delete: if false;
    }

    // Recommendations are public endorsements. The recommending producer owns
    // the record and cannot recommend their own account.
    match /producerRecommendations/{recommendationId} {
      allow read: if signedIn();
      allow create: if activeProducer(request.auth.uid)
        && request.resource.data.producerId == request.auth.uid
        && request.resource.data.recommendedProducerId is string
        && request.resource.data.recommendedProducerId != request.auth.uid
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && exists(/databases/$(database)/documents/farms/$(request.resource.data.recommendedProducerId));
      allow update: if activeProducer(request.auth.uid)
        && resource.data.producerId == request.auth.uid
        && request.resource.data.producerId == resource.data.producerId
        && request.resource.data.recommendedProducerId == resource.data.recommendedProducerId
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500;
      allow delete: if signedIn()
        && request.auth.uid == resource.data.producerId;
    }

    // Partnerships require a request and acceptance by the other producer.
    // Member identities are immutable after creation.
    match /producerPartnerships/{partnershipId} {
      function validPartnership(data) {
        return data.memberIds is list
          && data.memberIds.size() == 2
          && data.memberIds[0] is string
          && data.memberIds[1] is string
          && data.memberIds[0] != data.memberIds[1]
          && data.requestedBy is string
          && data.memberIds.hasAny([data.requestedBy])
          && data.status in ["pending", "accepted", "declined", "cancelled"]
          && data.pickupEnabled is bool
          && data.deliveryEnabled is bool
          && data.publicNote is string
          && data.publicNote.size() <= 500
          && exists(/databases/$(database)/documents/farms/$(data.memberIds[0]))
          && exists(/databases/$(database)/documents/farms/$(data.memberIds[1]));
      }

      allow read: if signedIn()
        && (
          resource.data.status == "accepted"
          || resource.data.memberIds.hasAny([request.auth.uid])
        );
      allow create: if activeProducer(request.auth.uid)
        && validPartnership(request.resource.data)
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.status == "pending";
      allow update: if activeProducer(request.auth.uid)
        && resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.requestedBy == resource.data.requestedBy
        && validPartnership(request.resource.data)
        && (
          (resource.data.status == "pending"
            && request.auth.uid != resource.data.requestedBy
            && request.resource.data.status in ["accepted", "declined"])
          || (resource.data.status in ["pending", "accepted"]
            && request.resource.data.status == "cancelled")
          || (resource.data.status == "accepted"
            && request.resource.data.status == "accepted")
        );
      allow delete: if false;
    }

    // Carts: own cart only
    match /carts/{cartId} {
      allow read, delete: if signedIn() && request.auth.uid == cartId;
      allow create, update: if signedIn()
        && request.auth.uid == cartId
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100
        && (
          !request.resource.data.keys().hasAny(["cartVersion"])
          || (
            request.resource.data.cartVersion is int
            && request.resource.data.cartVersion >= 0
          )
        );
    }

    // Buyers may only read their own server-created orders.
    match /orders/{orderId} {
      allow read: if signedIn() && resource.data.buyerId == request.auth.uid;
      allow write: if false;
    }

    // Producer order mirrors are server-authored. Producers update status only
    // through updateProducerOrderStatus so both buyer and producer views stay in sync.
    match /producerOrders/{producerId}/orders/{orderId} {
      allow read: if signedIn() && request.auth.uid == producerId;
      allow write: if false;
    }

    // Disputes, refunds, rate limits, and administration data are only handled
    // by trusted Cloud Functions.
    match /disputes/{document=**} {
      allow read, write: if false;
    }
    match /refunds/{document=**} {
      allow read, write: if false;
    }
    match /refund_requests/{document=**} {
      allow read, write: if false;
    }
    match /order_rate_limits/{document=**} {
      allow read, write: if false;
    }
  }
}
